<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root"
      Background="Transparent"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display">

  <Grid.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSoft" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LineSoft" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Ink" Color="#0F172A"/>
    <SolidColorBrush x:Key="InkSoft" Color="#334155"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="Accent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#C7D2FE"/>
    <SolidColorBrush x:Key="Success" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="SuccessInk" Color="#047857"/>
    <SolidColorBrush x:Key="Warn" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Danger" Color="#EF4444"/>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EEF2FF" Offset="0"/>
      <GradientStop Color="#F5F3FF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.07" Color="#0F172A"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="InputBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceSoft}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource LineSoft}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3730A3"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource LineSoft}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource LineSoft}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                <Setter Property="Foreground" Value="#DC2626"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                <Setter Property="Foreground" Value="#B91C1C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="10,8" Margin="0,0,0,6">
              <Grid>
                <Border x:Name="Bar" Width="3" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left" Margin="-7,7,0,7"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ClientCard" TargetType="CheckBox">
      <Setter Property="Width" Value="344"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="14,13">
              <Grid>
                <ContentPresenter/>
                <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White"
                             FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,10,0,10"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Grid.Resources>

  <Border Margin="22" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
          CornerRadius="18" Padding="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#0F172A"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="74"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="17,17,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,9,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#6366F1" Offset="0"/><GradientStop Color="#4F46E5" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="H" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="HyperContext Setup" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource CaptionButton}"/>
            <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CloseButton}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="212"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <Grid Margin="14,18,14,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="安装步骤" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"/>

            <Button x:Name="BtnStepEnv" Grid.Row="1" Style="{StaticResource NavButton}" Tag="active">
              <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" CornerRadius="8" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,10,0">
                  <TextBlock Text="1" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="环境检查" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="Node / 引擎 / 配置" FontSize="10.5" Opacity="0.72" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Button>

            <Button x:Name="BtnStepClients" Grid.Row="2" Style="{StaticResource NavButton}">
              <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" CornerRadius="8" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,10,0">
                  <TextBlock Text="2" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="选择客户端" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="国内版 / 国际版" FontSize="10.5" Opacity="0.72" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Button>

            <Button x:Name="BtnStepInstall" Grid.Row="3" Style="{StaticResource NavButton}">
              <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" CornerRadius="8" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,10,0">
                  <TextBlock Text="3" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="安装与配置" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock Text="构建 / 工件 / 代理" FontSize="10.5" Opacity="0.72" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Button>

            <Border Grid.Row="5" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
              <StackPanel>
                <TextBlock Text="本地安装" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="不会请求管理员权限；客户端配置修改前会备份。" FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>

                <StackPanel Grid.Row="6" Margin="10,12,0,0">
              <TextBlock x:Name="SidebarStatus" Text="准备就绪" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="v0.1.1 · Windows 10 / 11" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource HeroGradient}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                  CornerRadius="16" Padding="20" Margin="24,20,24,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TxtHeroTitle" Text="环境检查" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="TxtHeroSubtitle" Text="确认 Node、引擎和配置目录都就绪。" FontSize="12.5" Foreground="#475569" Margin="0,6,0,0"/>
              </StackPanel>
              <Border x:Name="StatusPill" Grid.Column="1" Background="#DCFCE7" CornerRadius="999" Padding="12,6" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" Text="未检查" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
              </Border>
            </Grid>
          </Border>

          <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,24,16">
            <StackPanel>
              <!-- Step 1 -->
              <StackPanel x:Name="PanelEnv">
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,8,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="项目目录" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtProject" Text="检查中…" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Ellipse x:Name="DotProject" Grid.Column="2" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Top" Margin="8,8,0,0"/>
                    </Grid>
                  </Border>

                  <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}" Margin="8,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Node.js" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtNode" Text="检查中…" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Ellipse x:Name="DotNode" Grid.Column="2" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Top" Margin="8,8,0,0"/>
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,8,8,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="引擎构建" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtEngines" Text="检查中…" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Ellipse x:Name="DotEngines" Grid.Column="2" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Top" Margin="8,8,0,0"/>
                    </Grid>
                  </Border>

                  <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Margin="8,8,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSoft}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="配置目录" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="TxtConfig" Text="检查中…" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Ellipse x:Name="DotConfig" Grid.Column="2" Width="8" Height="8" Fill="#CBD5E1" VerticalAlignment="Top" Margin="8,8,0,0"/>
                    </Grid>
                  </Border>
                </Grid>

                <TextBlock Text="网络代理（可选）" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputBox}" Margin="0,0,0,6">
                  <TextBox x:Name="TxtProxy" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{StaticResource Ink}"
                           VerticalContentAlignment="Center" ToolTip="例如 http://127.0.0.1:7897"/>
                </Border>
                <TextBlock Text="下载项目或依赖需要走代理时再填；留空则直连。" Style="{StaticResource Muted}" Margin="2,0,0,16"/>

                <WrapPanel>
                  <Button x:Name="BtnRecheck" Content="重新检查" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                  <Button x:Name="BtnSetupEnv" Content="安装 / 修复运行环境" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                  <Button x:Name="BtnBrowse" Content="选择项目目录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                  <Button x:Name="BtnDownloadProject" Content="下载项目" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,8,8"/>
                  <Button x:Name="BtnDownloadNode" Content="下载 Node 24" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>

              <!-- Step 2 -->
              <StackPanel x:Name="PanelClients" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="选择要配置的客户端" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="只对检测到的客户端修改配置；未检测到的只生成 MCP / 启动器工件。" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnSelectAll" Content="全选" Style="{StaticResource GhostButton}"/>
                        <Button x:Name="BtnClear" Content="清空" Style="{StaticResource GhostButton}"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="国际版" Style="{StaticResource SectionLabel}"/>
                    <WrapPanel x:Name="WrapIntl">
                      <CheckBox Style="{StaticResource ClientCard}" Tag="claude-code" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#D97757" Margin="0,0,12,0">
                            <TextBlock Text="C" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Claude Code" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Hooks + 统一 MCP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeClaudeCode" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="codex" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#10A37F" Margin="0,0,12,0">
                            <TextBlock Text="X" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Codex CLI" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="原生插件 + 统一 MCP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeCodex" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="qoder-intl" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#4F46E5" Margin="0,0,12,0">
                            <TextBlock Text="Q" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Qoder 国际版" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="代理启动器 + 统一 MCP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeQoderIntl" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="workbuddy-intl" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#0EA5E9" Margin="0,0,12,0">
                            <TextBlock Text="W" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="WorkBuddy 国际版" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="MCP 工件 + 代理 base URL" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeWorkBuddyIntl" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                    </WrapPanel>

                    <TextBlock Text="国内版" Style="{StaticResource SectionLabel}" Margin="0,14,0,10"/>
                    <WrapPanel x:Name="WrapCn">
                      <CheckBox Style="{StaticResource ClientCard}" Tag="qoder-cn" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#4338CA" Margin="0,0,12,0">
                            <TextBlock Text="Q" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Qoder 国内版" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="代理启动器 + 统一 MCP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeQoderCn" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="workbuddy-cn" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#0284C7" Margin="0,0,12,0">
                            <TextBlock Text="W" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="WorkBuddy 国内版" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="MCP 工件 + 代理 base URL" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeWorkBuddyCn" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="dsh" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#4D6BFE" Margin="0,0,12,0">
                            <TextBlock Text="D" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DeepSeek Harness" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="原生插件 + 代理" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeDsh" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ClientCard}" Tag="zcode" IsChecked="True">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" CornerRadius="12" Background="#8B5CF6" Margin="0,0,12,0">
                            <TextBlock Text="Z" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Zcode (Z.ai)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="启动器 + 统一 MCP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Border x:Name="BadgeZcode" Style="{StaticResource Badge}" Margin="0,8,0,0"><TextBlock Text="未检测" FontSize="10.5" Foreground="#475569"/></Border>
                          </StackPanel>
                        </Grid>
                      </CheckBox>
                    </WrapPanel>

                    <Border Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,4,0,0">
                      <TextBlock Text="Qoder 使用证书 MITM 启动器；WorkBuddy 需要把生成的 mcp.json 加入客户端，并把模型 base URL 指向本地代理。"
                                 Style="{StaticResource Muted}"/>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Step 3 -->
              <StackPanel x:Name="PanelInstall" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="安装任务" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="安装依赖、构建引擎、写入客户端工件，然后启动本地压缩代理。" Style="{StaticResource Muted}" Margin="0,4,0,14"/>

                    <Grid Height="8" Margin="0,0,0,10">
                      <Border x:Name="ProgressTrack" Background="{StaticResource LineSoft}" CornerRadius="4"/>
                      <Border x:Name="ProgressFill" Background="{StaticResource Accent}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="TxtProgress" Text="等待开始" FontSize="12.5" Foreground="{StaticResource InkSoft}"/>

                    <WrapPanel Margin="0,14,0,0">
                      <Button x:Name="BtnStop" Content="停止" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
                      <Button x:Name="BtnOpenHome" Content="打开配置目录" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border x:Name="LogCard" Background="#0F172A" CornerRadius="16" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="安装日志" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                    <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#CBD5E1"
                             FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Height="230"/>
                  </StackPanel>
                </Border>

                <Border x:Name="DoneCard" Background="{StaticResource SuccessSoft}" BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1"
                        CornerRadius="16" Padding="16" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Success}" Margin="0,0,12,0">
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtDone" Text="安装完成。" Foreground="{StaticResource SuccessInk}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="680"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Footer -->
      <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,16" CornerRadius="0,0,17,17">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtFooterNote" Text="安装到本地应用目录，配置写入 ~/.hypercontext" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnBack" Content="上一步" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="BtnInstall" Content="下一步" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Grid>
