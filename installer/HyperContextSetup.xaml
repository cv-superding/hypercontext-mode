<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root"
      Background="#F6F7F9"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display">

  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#111827"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Navy" Color="#0B1220"/>
    <SolidColorBrush x:Key="NavySoft" Color="#1F2937"/>
    <SolidColorBrush x:Key="Success" Color="#16A34A"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,10,0,8"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="ClientCard" TargetType="CheckBox">
      <Setter Property="Width" Value="344"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Card" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1"
                        Background="White" VerticalAlignment="Top" Margin="0,1,12,0">
                  <Path x:Name="Tick" Data="M 3,8 L 7,12 L 15,4" Stroke="White" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="Fill" Value="#CBD5E1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1F2937"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#334155"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="38"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Navy}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
        <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource Accent}" Margin="0,0,8,0">
          <TextBlock Text="H" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="HyperContext Setup" Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource CaptionButton}"/>
        <Button x:Name="BtnClose" Content="×" Style="{StaticResource CaptionButton}"/>
      </StackPanel>
    </Grid>
  </Border>

  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border Grid.Column="0" Background="{StaticResource Navy}">
    <Grid Margin="26,28,26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Accent}" Margin="0,0,10,0">
            <TextBlock Text="H" Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="HyperContext" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="统一上下文安装器" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <Border Height="1" Background="#1F2937" Margin="0,22,0,22"/>
      </StackPanel>

      <StackPanel Grid.Row="1">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource Accent}" Margin="0,0,10,0">
            <TextBlock Text="01" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="环境检查" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="Node / 引擎 / 配置" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource NavySoft}" Margin="0,0,10,0">
            <TextBlock Text="02" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="选择客户端" Foreground="#E5E7EB" FontSize="13"/>
            <TextBlock Text="国内版 / 国际版分开" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource NavySoft}" Margin="0,0,10,0">
            <TextBlock Text="03" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="安装与配置" Foreground="#E5E7EB" FontSize="13"/>
            <TextBlock Text="自动备份后再修改" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource NavySoft}" Margin="0,0,10,0">
            <TextBlock Text="04" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="完成" Foreground="#E5E7EB" FontSize="13"/>
            <TextBlock Text="启动代理并查看状态" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="3">
        <TextBlock x:Name="SidebarStatus" Text="准备就绪" Foreground="#CBD5E1" FontSize="11"/>
        <TextBlock Text="v0.1.0 · Windows 10 / 11" Foreground="#64748B" FontSize="10" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Main -->
  <Grid Grid.Column="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,26,28,8">
      <StackPanel>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="安装与配置" Style="{StaticResource Title}"/>
            <TextBlock Text="为你的 AI 客户端装好沙箱层与压缩层。全程本地运行，不注册账号。"
                       Style="{StaticResource Muted}" Margin="0,6,0,0"/>
          </StackPanel>
          <Border x:Name="StatusPill" Grid.Column="1" Background="#E5E7EB" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
            <TextBlock x:Name="StatusText" Text="未检查" Foreground="#374151" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </Grid>

        <!-- Environment -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="1. 环境检查" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="安装器会优先使用项目内的便携 Node；没有则检测系统 Node。"
                       Style="{StaticResource Muted}" Margin="0,4,0,6"/>

            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotProject" Style="{StaticResource Dot}"/>
              <TextBlock Grid.Column="1" Text="项目目录" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtProject" Grid.Column="2" Text="检查中…" FontSize="12" Foreground="#111827"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" MaxWidth="520"/>
              <Button x:Name="BtnBrowse" Grid.Column="3" Content="浏览" Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="11"/>
            </Grid>

            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotNode" Style="{StaticResource Dot}"/>
              <TextBlock Grid.Column="1" Text="Node.js" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtNode" Grid.Column="2" Text="检查中…" FontSize="12" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" MaxWidth="520"/>
              <Button x:Name="BtnDownloadNode" Grid.Column="3" Content="下载 Node 24" Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="11" Visibility="Collapsed"/>
            </Grid>

            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotEngines" Style="{StaticResource Dot}"/>
              <TextBlock Grid.Column="1" Text="引擎构建" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtEngines" Grid.Column="2" Text="检查中…" FontSize="12" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14"/><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DotConfig" Style="{StaticResource Dot}"/>
              <TextBlock Grid.Column="1" Text="配置目录" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtConfig" Grid.Column="2" Text="检查中…" FontSize="12" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" MaxWidth="520"/>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="网络代理" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <TextBox x:Name="TxtProxy" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="#111827"
                         VerticalContentAlignment="Center" ToolTip="可选，例如 http://127.0.0.1:7897"/>
              </Border>
            </Grid>
            <TextBlock Text="下载项目或依赖需要走代理时再填；留空则直连。"
                       Style="{StaticResource Muted}" Margin="112,6,0,0"/>

            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="BtnRecheck" Content="重新检查" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
              <Button x:Name="BtnDownloadProject" Content="下载项目" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Visibility="Collapsed"/>
              <Button x:Name="BtnSetupEnv" Content="安装 / 修复运行环境" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Clients -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="2. 选择客户端" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="国内版与国际版分开放；只对检测到的客户端修改配置，其余只生成工件。"
                           Style="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnSelectAll" Content="全选" Style="{StaticResource LinkButton}"/>
                <Button x:Name="BtnClear" Content="清空" Style="{StaticResource LinkButton}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="国际版" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="WrapIntl">
              <CheckBox Style="{StaticResource ClientCard}" Tag="claude-code" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Claude Code" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="Hooks + 统一 MCP" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="codex" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Codex CLI" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="原生插件 + 统一 MCP" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="qoder-intl" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Qoder 国际版" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="代理启动器 + 统一 MCP" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="workbuddy-intl" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="WorkBuddy 国际版" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="MCP 工件 + 代理 base URL" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
            </WrapPanel>

            <TextBlock Text="国内版" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="WrapCn">
              <CheckBox Style="{StaticResource ClientCard}" Tag="qoder-cn" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Qoder 国内版" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="代理启动器 + 统一 MCP" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="workbuddy-cn" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="WorkBuddy 国内版" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="MCP 工件 + 代理 base URL" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="dsh" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="DeepSeek Harness" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="原生插件 + 代理" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
              <CheckBox Style="{StaticResource ClientCard}" Tag="zcode" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Zcode (Z.ai)" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                  <TextBlock Text="插件 / 启动器 + 统一 MCP" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>
              </CheckBox>
            </WrapPanel>

            <TextBlock Text="Qoder 使用证书 MITM 启动器；WorkBuddy 需要把生成的 MCP 工件加入客户端，并把模型 base URL 指向本地代理。"
                       Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Install -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="3. 安装与配置" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="安装依赖、构建引擎、写入客户端工件，然后启动本地压缩代理。"
                       Style="{StaticResource Muted}" Margin="0,4,0,10"/>

            <Grid Height="6" Margin="0,2,0,10">
              <Border x:Name="ProgressTrack" Background="#E5E7EB" CornerRadius="3"/>
              <Border x:Name="ProgressFill" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="TxtProgress" Text="等待开始" FontSize="12" Foreground="#374151"/>

            <Border x:Name="LogCard" Background="{StaticResource Navy}" CornerRadius="10" Margin="0,14,0,0" Padding="12" Visibility="Collapsed">
              <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#CBD5E1"
                       FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Height="210"/>
            </Border>

            <Border x:Name="DoneCard" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10"
                    Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Success}" Margin="0,0,10,0">
                  <TextBlock Text="✓" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtDone" Text="安装完成。" Foreground="#166534" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtFooterNote" Text="安装到本地应用目录，配置写入 ~/.hypercontext"
                   Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="BtnStop" Content="停止" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Button x:Name="BtnOpenHome" Content="打开配置目录" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</Grid>
